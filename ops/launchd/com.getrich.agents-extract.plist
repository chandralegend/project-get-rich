<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Needs ANTHROPIC_API_KEY in the project's .env. Not installed by the default install; use `install-agents`. -->
<dict>
  <key>Label</key><string>com.getrich.agents-extract</string>
  <key>ProgramArguments</key>
  <array><string>__PROJECT__/.venv/bin/getrich</string><string>agents-extract</string><string>--limit</string><string>80</string></array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>__PROJECT__/data/logs/launchd-agents-extract.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/data/logs/launchd-agents-extract.log</string>
</dict>
</plist>
