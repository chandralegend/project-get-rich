<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.getrich.collect-binance</string>
  <key>ProgramArguments</key>
  <array><string>__PROJECT__/.venv/bin/getrich</string><string>collect-binance</string><string>--timeframe</string><string>1d</string><string>1h</string></array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__PROJECT__/data/logs/launchd-collect-binance.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/data/logs/launchd-collect-binance.log</string>
</dict>
</plist>
